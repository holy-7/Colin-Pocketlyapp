{
  "name": "colin-accounting",
  "version": "1.0.0",
  "description": "Colin记账 — 数据自控 + 极简无广告 + AI 对话式财务助手",
  "author": "Colin",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "node scripts/electron-dev.js",
    "build": "vite build && tsc -p tsconfig.electron.json",
    "build:web": "vite build",
    "build:electron": "tsc -p tsconfig.electron.json",
    "electron:build": "npm run build && electron-builder",
    "package:win": "npm run build && electron-builder --win",
    "package:mac": "npm run build && electron-builder --mac",
    "lint": "eslint src --ext .ts,.tsx",
    "test": "vitest",
    "test:run": "vitest run",
    "typecheck": "tsc --noEmit",
    "electron:fix": "node -e \"process.env.ELECTRON_MIRROR='https://npmmirror.com/mirrors/electron/';require('child_process').execSync('node node_modules/electron/install.js',{stdio:'inherit'})\""
  },
  "build": {
    "appId": "com.colin.accounting",
    "productName": "Colin记账",
    "directories": {
      "output": "release"
    },
    "publish": {
      "provider": "github",
      "owner": "holy-7",
      "repo": "Colin-Pocketlyapp"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "resources/logo.ico",
      "signAndEditExecutable": false
    },
    "mac": {
      "target": {
        "target": "dmg",
        "arch": ["arm64"]
      },
      "icon": "resources/logo.png",
      "identity": null,
      "hardenedRuntime": false,
      "gatekeeperAssess": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "dependencies": {
    "@ant-design/icons": "^5.5.1",
    "@supabase/supabase-js": "^2.46.0",
    "antd": "^5.22.0",
    "dayjs": "^1.11.13",
    "dexie": "^4.0.8",
    "electron-updater": "^6.8.9",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "openai": "^6.49.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "recharts": "^2.13.3",
    "xlsx": "^0.18.5",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@typescript-eslint/eslint-plugin": "^8.16.0",
    "@typescript-eslint/parser": "^8.16.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.5.4",
    "concurrently": "^9.1.0",
    "electron": "^28.3.3",
    "electron-builder": "^24.13.3",
    "eslint": "^8.57.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^25.0.1",
    "postcss": "^8.5.21",
    "supabase": "^2.110.0",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vite-plugin-pwa": "^0.21.0",
    "vitest": "^2.1.8",
    "wait-on": "^8.0.1"
  }
}
